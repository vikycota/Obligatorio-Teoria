parser code {:
  public static int errores = 0;
  private int erroresSemanticos = 0;

  /* El lexer marca el token que abrió la rutina, incluso si CUP ya pidió
     un token de la siguiente al momento de reducir la actual. */
  public static final class TokenRutina {
    private boolean tieneErroresLexicos;

    void marcarErrorLexico() { tieneErroresLexicos = true; }
    boolean tieneErroresLexicos() { return tieneErroresLexicos; }

    @Override
    public String toString() { return "RUTINA"; }
  }

  /* ===================== MODELO INTERMEDIO =====================
     El cuerpo y los campos originales conservan exactamente lo declarado.
     Por separado, Rutina expone los campos efectivos y los ejercicios
     resueltos de Igual a, con EXCEPTO aplicado en cada capa, sin expandir las
     repeticiones. */

  public static final class Campo {
    public final String nombre;
    public final int linea;
    public final Object valor;

    public Campo(String nombre, int linea, Object valor) {
      this.nombre = nombre;
      this.linea = linea;
      this.valor = valor;
    }

    /* Los valores de los campos pueden contener listas y, en Extra, arreglos.
       Cada rutina recibe copias propias para que la herencia no comparta
       estructuras mutables con su origen. */
    private static Object copiarValor(Object valor) {
      if (valor instanceof List<?>) {
        List<Object> copia = new ArrayList<>();
        for (Object elemento : (List<?>) valor)
          copia.add(copiarValor(elemento));
        return copia;
      }
      if (valor instanceof String[])
        return ((String[]) valor).clone();
      return valor;
    }

    public Campo copiar() {
      return new Campo(nombre, linea, copiarValor(valor));
    }
  }

  public enum TipoEspecificacion {
    SERIES_REPETICIONES, SERIES_MAXIMO, SERIES_TIEMPO, REPETICIONES, TIEMPO
  }

  public static final class EspecificacionEjercicio {
    public final TipoEspecificacion tipo;
    public final String valor;
    public final String carga;
    public final String descanso;
    public final String velocidad;

    public EspecificacionEjercicio(TipoEspecificacion tipo, String valor,
                                   String carga, String descanso, String velocidad) {
      this.tipo = tipo;
      this.valor = valor;
      this.carga = carga;
      this.descanso = descanso;
      this.velocidad = velocidad;
    }

    public EspecificacionEjercicio(String tipo, String valor,
                                   String carga, String descanso, String velocidad) {
      this(TipoEspecificacion.valueOf(tipo), valor, carga, descanso, velocidad);
    }
  }

  public interface ElementoEjercicio {
    String getNombre();
  }

  public static final class Ejercicio implements ElementoEjercicio {
    public final String nombre;
    public final EspecificacionEjercicio especificacion;

    public Ejercicio(String nombre, EspecificacionEjercicio especificacion) {
      this.nombre = nombre;
      this.especificacion = especificacion;
    }

    @Override
    public String getNombre() { return nombre; }
  }

  public static final class Superserie implements ElementoEjercicio {
    public final String nombre; // null cuando no fue nombrada
    public final BigInteger vueltas;
    public final List<ElementoEjercicio> ejercicios;
    public final String descanso;

    public Superserie(String nombre, BigInteger vueltas,
                      List<ElementoEjercicio> ejercicios, String descanso) {
      this.nombre = nombre;
      this.vueltas = vueltas;
      this.ejercicios = Collections.unmodifiableList(new ArrayList<>(ejercicios));
      this.descanso = descanso;
    }

    @Override
    public String getNombre() { return nombre; }
  }

  public enum TipoRepeticion { NINGUNA, VECES, PORCENTAJE }

  public static final class ModificadorRepeticion {
    public final TipoRepeticion tipo;
    public final BigInteger veces;
    /* Se conserva el token completo (por ejemplo, "200%"). Puede superar int. */
    public final String porcentaje;

    private ModificadorRepeticion(TipoRepeticion tipo,
                                  BigInteger veces, String porcentaje) {
      this.tipo = tipo;
      this.veces = veces;
      this.porcentaje = porcentaje;
    }

    public ModificadorRepeticion(BigInteger veces, String porcentaje) {
      this(veces != null ? TipoRepeticion.VECES
                         : porcentaje != null ? TipoRepeticion.PORCENTAJE
                                              : TipoRepeticion.NINGUNA,
           veces, porcentaje);
    }

    public static ModificadorRepeticion ninguno() {
      return new ModificadorRepeticion(TipoRepeticion.NINGUNA, null, null);
    }

    public static ModificadorRepeticion veces(BigInteger cantidad) {
      return new ModificadorRepeticion(TipoRepeticion.VECES, cantidad, null);
    }

    public static ModificadorRepeticion porcentaje(String valor) {
      return new ModificadorRepeticion(TipoRepeticion.PORCENTAJE, null, valor);
    }

    public boolean estaPresente() { return tipo != TipoRepeticion.NINGUNA; }
    public boolean usaVeces() { return tipo == TipoRepeticion.VECES; }
    public boolean usaPorcentaje() { return tipo == TipoRepeticion.PORCENTAJE; }
  }

  /* Una capa por cada Igual a. Las vueltas se guardan como dato y cada capa
     tiene una lista de elementos visibles; nunca se materializan N copias de
     los ejercicios. */
  public static final class EjecucionRutina {
    public final List<ElementoEjercicio> ejerciciosVisibles;
    /* Alias conservado para los consumidores existentes del modelo. */
    public final List<ElementoEjercicio> ejerciciosOriginales;
    public final ModificadorRepeticion repeticion;
    public final EjecucionRutina ejecucionReferenciada;

    public EjecucionRutina(List<ElementoEjercicio> ejerciciosOriginales,
                           ModificadorRepeticion repeticion,
                           EjecucionRutina ejecucionReferenciada) {
      this.ejerciciosVisibles = Collections.unmodifiableList(
          new ArrayList<>(ejerciciosOriginales));
      this.ejerciciosOriginales = ejerciciosVisibles;
      this.repeticion = repeticion;
      this.ejecucionReferenciada = ejecucionReferenciada;
    }

    public Optional<BigInteger> getCantidadVueltas() {
      return Optional.ofNullable(repeticion.veces);
    }

    /* Cantidad que debe ejecutar el consumidor, independientemente de cómo se
       haya escrito el modificador. La declaración original sigue disponible
       en repeticion para distinguir ausencia, x 1 vez y 100%. */
    public BigInteger getVueltasEfectivas() {
      if (repeticion.usaVeces())
        return repeticion.veces;
      if (repeticion.usaPorcentaje()) {
        String cantidad = repeticion.porcentaje.substring(
            0, repeticion.porcentaje.length() - 1);
        return new BigInteger(cantidad).divide(
            BigInteger.valueOf(100));
      }
      return BigInteger.ONE;
    }

    public List<ElementoEjercicio> getEjerciciosOriginales() {
      return ejerciciosVisibles;
    }

    public List<ElementoEjercicio> getEjerciciosVisibles() {
      return ejerciciosVisibles;
    }
  }

  public static final class CuerpoRutina {
    public final List<ElementoEjercicio> ejerciciosPropios;
    public final String rutinaReferenciada;
    public final int lineaReferencia;
    public final ModificadorRepeticion repeticion;
    public final List<String> exclusiones;
    public final boolean tieneExclusiones;
    public final int lineaExclusiones;

    public CuerpoRutina(List<ElementoEjercicio> ejercicios, String referencia,
                        ModificadorRepeticion repeticion, List<String> exclusiones) {
      this(ejercicios, referencia, -1, repeticion, exclusiones,
           !exclusiones.isEmpty(), -1);
    }

    public CuerpoRutina(List<ElementoEjercicio> ejercicios, String referencia,
                        int lineaReferencia, ModificadorRepeticion repeticion,
                        List<String> exclusiones) {
      this(ejercicios, referencia, lineaReferencia, repeticion, exclusiones,
           !exclusiones.isEmpty(), -1);
    }

    public CuerpoRutina(List<ElementoEjercicio> ejercicios, String referencia,
                        int lineaReferencia, ModificadorRepeticion repeticion,
                        List<String> exclusiones, boolean tieneExclusiones,
                        int lineaExclusiones) {
      this.ejerciciosPropios = Collections.unmodifiableList(new ArrayList<>(ejercicios));
      this.rutinaReferenciada = referencia;
      this.lineaReferencia = lineaReferencia;
      this.repeticion = repeticion;
      this.exclusiones = Collections.unmodifiableList(new ArrayList<>(exclusiones));
      this.tieneExclusiones = tieneExclusiones;
      this.lineaExclusiones = lineaExclusiones;
    }

    public static CuerpoRutina conEjercicios(List<ElementoEjercicio> ejercicios) {
      return new CuerpoRutina(ejercicios, null, ModificadorRepeticion.ninguno(),
                              Collections.emptyList());
    }

    public static CuerpoRutina conReferencia(String referencia,
                                             ModificadorRepeticion repeticion,
                                             List<String> exclusiones) {
      return new CuerpoRutina(Collections.emptyList(), referencia, repeticion, exclusiones);
    }

    public static CuerpoRutina conReferencia(String referencia, int lineaReferencia,
                                             ModificadorRepeticion repeticion,
                                             List<String> exclusiones) {
      return new CuerpoRutina(Collections.emptyList(), referencia, lineaReferencia,
                              repeticion, exclusiones);
    }

    public boolean esReferencia() { return rutinaReferenciada != null; }
  }

  /* Distingue la ausencia de la cláusula de EXCEPTO []. */
  public static final class ClausulaExclusion {
    public final List<String> nombres;
    public final boolean presente;
    public final int linea;

    public ClausulaExclusion(List<String> nombres, boolean presente, int linea) {
      this.nombres = nombres;
      this.presente = presente;
      this.linea = linea;
    }
  }

  public static final class Rutina {
    public final String nombre;
    /* Alias histórico: campos siempre representa la declaración original. */
    public final List<Campo> campos;
    public final List<Campo> camposOriginales;
    public final List<Campo> camposEfectivos;
    public final CuerpoRutina cuerpo;
    public final EjecucionRutina ejecucion;
    /* Alias conservado para los consumidores existentes del modelo. */
    public final List<ElementoEjercicio> ejercicios;
    public final boolean validaSemanticamente;
    public final int cantidadErroresSemanticos;
    public final boolean tieneErroresLexicos;

    public Rutina(String nombre, List<Campo> campos, CuerpoRutina cuerpo) {
      this(nombre, campos, cuerpo, true, 0);
    }

    public Rutina(String nombre, List<Campo> campos, CuerpoRutina cuerpo,
                  boolean validaSemanticamente, int cantidadErroresSemanticos) {
      this(nombre, campos, cuerpo,
           new EjecucionRutina(cuerpo.ejerciciosPropios,
                               ModificadorRepeticion.ninguno(), null),
           validaSemanticamente, cantidadErroresSemanticos);
    }

    public Rutina(String nombre, List<Campo> campos, CuerpoRutina cuerpo,
                  EjecucionRutina ejecucion,
                  boolean validaSemanticamente, int cantidadErroresSemanticos) {
      this(nombre, campos, campos, cuerpo, ejecucion,
           validaSemanticamente, cantidadErroresSemanticos);
    }

    public Rutina(String nombre, List<Campo> camposOriginales,
                  List<Campo> camposEfectivos, CuerpoRutina cuerpo,
                  EjecucionRutina ejecucion,
                  boolean validaSemanticamente, int cantidadErroresSemanticos) {
      this(nombre, camposOriginales, camposEfectivos, cuerpo, ejecucion,
           validaSemanticamente, cantidadErroresSemanticos, false);
    }

    public Rutina(String nombre, List<Campo> camposOriginales,
                  List<Campo> camposEfectivos, CuerpoRutina cuerpo,
                  EjecucionRutina ejecucion, boolean validaSemanticamente,
                  int cantidadErroresSemanticos, boolean tieneErroresLexicos) {
      this.nombre = nombre;
      this.camposOriginales = copiarCampos(camposOriginales);
      this.campos = this.camposOriginales;
      this.camposEfectivos = copiarCampos(camposEfectivos);
      this.cuerpo = cuerpo;
      this.ejecucion = ejecucion;
      this.ejercicios = ejecucion.getEjerciciosVisibles();
      this.validaSemanticamente = validaSemanticamente;
      this.cantidadErroresSemanticos = cantidadErroresSemanticos;
      this.tieneErroresLexicos = tieneErroresLexicos;
    }

    public boolean esValida() {
      return validaSemanticamente && !tieneErroresLexicos;
    }

    private static List<Campo> copiarCampos(List<Campo> campos) {
      List<Campo> copia = new ArrayList<>();
      for (Campo campo : campos)
        copia.add(campo.copiar());
      return Collections.unmodifiableList(copia);
    }

    public List<ElementoEjercicio> getEjercicios() {
      return ejercicios;
    }

    public List<Campo> getCamposOriginales() {
      return camposOriginales;
    }

    public List<Campo> getCamposEfectivos() {
      return camposEfectivos;
    }
  }

  /* Las claves son canónicas: sin tildes, en minúsculas y sin espacios externos.
     Rutina.nombre siempre conserva el texto original de la declaración. */
  private final LinkedHashMap<String, Rutina> rutinasDeclaradas = new LinkedHashMap<>();
  /* Incluye también declaraciones duplicadas o semánticamente inválidas. */
  private final List<Rutina> rutinasProcesadas = new ArrayList<>();

  public static String claveRutina(String nombre) {
    return java.text.Normalizer.normalize(nombre, java.text.Normalizer.Form.NFD)
        .replaceAll("\\p{M}", "").toLowerCase(Locale.ROOT).trim();
  }

  /* Las claves expuestas por este mapa siguen el criterio canónico documentado. */
  public Map<String, Rutina> getRutinasDeclaradas() {
    return Collections.unmodifiableMap(rutinasDeclaradas);
  }

  public List<Rutina> getRutinasProcesadas() {
    return Collections.unmodifiableList(rutinasProcesadas);
  }

  public Optional<Rutina> buscarRutina(String nombre) {
    return Optional.ofNullable(rutinasDeclaradas.get(claveRutina(nombre)));
  }

  /* Punto de entrada seguro para la resolución de Igual a. */
  public Optional<Rutina> buscarRutinaValida(String nombre) {
    return buscarRutina(nombre).filter(Rutina::esValida);
  }

  boolean rutinaYaDeclarada(String nombre) {
    return rutinasDeclaradas.containsKey(claveRutina(nombre));
  }

  void registrarRutina(Rutina rutina, boolean nombreNuevo) {
    rutinasProcesadas.add(rutina);
    if (nombreNuevo)
      rutinasDeclaradas.put(claveRutina(rutina.nombre), rutina);
  }

  void registrarErrorSemantico() {
    erroresSemanticos++;
  }

  int getErroresSemanticos() {
    return erroresSemanticos;
  }

  /* Formato único para todos los errores: [Línea N] Error <tipo>: <mensaje> */
  public static void reportar(int linea, String tipo, String msg) {
    errores++;
    System.err.println("[Línea " + linea + "] Error " + tipo + ": " + msg);
  }

  @Override
  public void syntax_error(Symbol s) {
    if (s.sym == sym.EOF)
      reportar(s.left, "sintáctico", "el archivo terminó antes de lo esperado");
    else
      reportar(s.left, "sintáctico", "no se esperaba '" + s.value + "'");
  }

  @Override
  public void unrecovered_syntax_error(Symbol s) {
    System.err.println("No se pudo recuperar del error. Análisis abortado.");
  }

  public static void main(String[] args) throws Exception {
    if (args.length != 1) {
      System.err.println("Uso: parser <archivo del plan>");
      return;
    }

    errores = 0;
    try (Reader in = new InputStreamReader(new FileInputStream(args[0]), StandardCharsets.UTF_8)) {
      new parser(new Lexer(in)).parse();
    }

    if (errores == 0) System.out.println("Análisis terminado: el plan es válido.");
    else System.out.println("Análisis terminado con " + errores + " error(es).");
  }
:};

action code {:
  void error(int linea, String msg) {
    parser.registrarErrorSemantico();
    parser.reportar(linea, "semántico", msg);
  }

  /* Quita tildes y pasa a minúsculas: "Miércoles" -> "miercoles" */
  String normalizar(String s) {
    return parser.claveRutina(s);
  }

  /* BigInteger evita desbordamientos con cantidades grandes. */
  BigInteger entero(String valor) {
      return new BigInteger(valor);
  }

  /* ===================== ENCABEZADO ===================== */

  final Set<String> NIVELES = Set.of("principiante", "intermedio", "avanzado");

  void validarNivel(String nivel, int linea) {
    if (!NIVELES.contains(normalizar(nivel)))
      error(linea, "nivel inválido '" + nivel + "' (se espera PRINCIPIANTE, INTERMEDIO o AVANZADO)");
  }

  void validarSemanas(String cantidad, int linea) {
    BigInteger semanas = entero(cantidad);
    if (semanas.signum() <= 0 || semanas.compareTo(BigInteger.valueOf(52)) > 0)
      error(linea, "Semanas debe estar entre 1 y 52 (se encontró " + cantidad + ")");
  }

  void validarTexto(String texto, int linea, String mensaje) {
    if (texto.trim().isEmpty())
      error(linea, mensaje);
  }

  void validarFecha(String fecha, int linea) {
    String[] partes = fecha.split("/");
    if (partes[0].length() > 2 || partes[1].length() > 2 || partes[2].length() != 4) {
      error(linea, "fecha '" + fecha + "': se espera día/mes/año con un año de 4 dígitos");
      return;
    }

    int dia = Integer.parseInt(partes[0]);
    int mes = Integer.parseInt(partes[1]);
    int anio = Integer.parseInt(partes[2]);
    try {
      if (anio == 0) throw new DateTimeException("el año debe ser mayor que 0");
      LocalDate.of(anio, mes, dia);
    } catch (DateTimeException e) {
      error(linea, "fecha inválida '" + fecha + "'");
    }
  }

  /* Objetivos, músculos, equipamiento, variantes: no vacía y sin repetidos */
  parser.Campo crearCampoLista(String campo, List<String> valores, int linea) {
    if (valores.isEmpty())
      error(linea, "la lista de " + campo + " está vacía");

    Set<String> vistos = new HashSet<>();
    for (String valor : valores)
      if (!vistos.add(normalizar(valor)))
        error(linea, campo + ": '" + valor + "' está repetido");
    return new parser.Campo(campo, linea, valores);
  }

  void validarEncabezado(List<parser.Campo> campos, int linea) {
    Set<String> vistos = validarDuplicados(campos);
    for (String obligatorio : List.of("Nivel", "Objetivos", "Semanas", "Profesor", "Fecha"))
      if (!vistos.contains(obligatorio))
        error(linea, "al encabezado le falta el campo " + obligatorio);
  }

  /* ===================== RUTINA ===================== */

  final Set<String> DIAS = Set.of("lunes", "martes", "miercoles", "jueves",
                                   "viernes", "sabado", "domingo");

  void validarDia(String d, int linea) {
    if (!DIAS.contains(normalizar(d)))
      error(linea, "día inválido '" + d + "'");
  }

  /* Intensidad en 3 notaciones. Devuelve el nivel 1..5, o 0 si es inválida.
     Texto: MUY BAJA=1, BAJA=2, MEDIA=3, ALTA=4, MUY ALTA=5 (decisión de diseño). */
  int intensidadTexto(String t, int linea) {
    switch (normalizar(t)) {
      case "muy baja": return 1;
      case "baja":     return 2;
      case "media":    return 3;
      case "alta":     return 4;
      case "muy alta": return 5;
    }
    error(linea, "intensidad inválida '" + t + "' (se espera MUY BAJA, BAJA, MEDIA, ALTA o MUY ALTA)");
    return 0;
  }

  int intensidadEstrellas(String e, int linea) {
    if (e.length() > 5) {
      error(linea, "intensidad '" + e + "': como máximo 5 estrellas");
      return 0;
    }
    return e.length();
  }

  int intensidadFraccion(String f, int linea) {
    String[] partes = f.split("/");
    BigInteger numero = entero(partes[0]);
    if (!entero(partes[1]).equals(BigInteger.valueOf(5))) {
      error(linea, "intensidad '" + f + "': debe expresarse sobre 5 (ej. 4/5)");
      return 0;
    }
    if (numero.signum() <= 0 || numero.compareTo(BigInteger.valueOf(5)) > 0) {
      error(linea, "intensidad '" + f + "': debe estar entre 1/5 y 5/5");
      return 0;
    }
    return numero.intValue();
  }

  /* Duración en h, m o s. Se devuelve en minutos. */
  double validarDuracion(String t, int linea) {
    double n = entero(t.substring(0, t.length() - 1)).doubleValue();
    char unidad = t.charAt(t.length() - 1);
    double minutos = unidad == 'h' ? n * 60 : unidad == 'm' ? n : n / 60;
    if (minutos <= 0) error(linea, "la duración debe ser mayor que 0");
    else if (minutos > 24 * 60) error(linea, "la duración '" + t + "' supera las 24 horas");
    return minutos;
  }

  /* Extra: etiqueta=valor, sin etiquetas repetidas */
  void validarExtra(List<String[]> pares, int linea) {
    Set<String> etiquetas = new HashSet<>();
    for (String[] par : pares)
      if (!etiquetas.add(normalizar(par[0])))
        error(linea, "Extra: la etiqueta '" + par[0] + "' está repetida");
  }

  /* Devuelve los nombres de campos vistos y avisa los repetidos */
  Set<String> validarDuplicados(List<parser.Campo> campos) {
    Set<String> vistos = new HashSet<>();
    for (parser.Campo c : campos)
      if (!vistos.add(c.nombre))
        error(c.linea, "el campo " + c.nombre + " aparece más de una vez");
    return vistos;
  }

  final Pattern PALABRA_RESERVADA = Pattern.compile(
      "(?iU)\\b(?:superserie|fin)\\b");

  void validarNombreReservado(String nombre, String tipo, int linea) {
    if (PALABRA_RESERVADA.matcher(nombre).find())
      error(linea, "el nombre " + tipo + " '" + nombre + "' contiene FIN o SUPERSERIE");
  }

  boolean validarDeclaracionRutina(
      String nombre, List<parser.Campo> campos, int linea) {
    validarDuplicados(campos);
    if (nombre.trim().isEmpty()) {
      error(linea, "la rutina no tiene nombre");
      return false;
    }
    validarNombreReservado(nombre, "de la rutina", linea);
    if (parser.rutinaYaDeclarada(nombre)) {
      error(linea, "ya existe una rutina llamada '" + nombre + "'");
      return false;
    }
    return true;
  }

  void validarCamposObligatorios(String nombre, List<parser.Campo> campos, int linea) {
    Set<String> disponibles = new HashSet<>();
    for (parser.Campo campo : campos)
      disponibles.add(campo.nombre);
    for (String obligatorio : List.of("Día", "Intensidad", "Duración", "Músculos"))
      if (!disponibles.contains(obligatorio))
        error(linea, "a la rutina '" + nombre + "' le falta el campo " + obligatorio);
  }

  /* Los campos declarados reemplazan a los heredados. Rutina copia los
     valores al guardar los campos efectivos. */
  List<parser.Campo> resolverCampos(
      List<parser.Campo> declarados, parser.Rutina origen) {
    LinkedHashMap<String, parser.Campo> resueltos = new LinkedHashMap<>();
    if (origen != null)
      for (parser.Campo heredado : origen.getCamposEfectivos())
        resueltos.put(heredado.nombre, heredado);
    for (parser.Campo declarado : declarados)
      resueltos.put(declarado.nombre, declarado);
    return new ArrayList<>(resueltos.values());
  }

  List<parser.ElementoEjercicio> aplicarExclusiones(
      List<parser.ElementoEjercicio> ejercicios, parser.CuerpoRutina cuerpo) {
    if (!cuerpo.tieneExclusiones)
      return ejercicios;

    int linea = cuerpo.lineaExclusiones;
    if (cuerpo.exclusiones.isEmpty()) {
      error(linea, "EXCEPTO requiere al menos un nombre");
      return ejercicios;
    }

    Map<String, String> exclusionesUnicas = new LinkedHashMap<>();
    for (String nombre : cuerpo.exclusiones) {
      if (exclusionesUnicas.putIfAbsent(normalizar(nombre), nombre) != null)
        error(linea, "EXCEPTO: el nombre '" + nombre + "' está repetido");
    }

    Set<String> encontradas = new HashSet<>();
    List<parser.ElementoEjercicio> visibles =
        filtrarEjercicios(ejercicios, exclusionesUnicas.keySet(), encontradas);
    for (Map.Entry<String, String> exclusion : exclusionesUnicas.entrySet())
      if (!encontradas.contains(exclusion.getKey()))
        error(linea, "EXCEPTO: '" + exclusion.getValue()
            + "' no corresponde a ningún ejercicio ni superserie con nombre "
            + "de la rutina referenciada");
    return visibles;
  }

  /* Conserva las vueltas y el descanso si se quita un ejercicio de una superserie. */
  List<parser.ElementoEjercicio> filtrarEjercicios(
      List<parser.ElementoEjercicio> ejercicios, Set<String> exclusiones,
      Set<String> encontradas) {
    List<parser.ElementoEjercicio> visibles = new ArrayList<>();
    for (parser.ElementoEjercicio ejercicio : ejercicios) {
      String nombre = ejercicio.getNombre();
      String clave = nombre == null ? null : normalizar(nombre);
      boolean excluir = exclusiones.contains(clave);
      if (excluir)
        encontradas.add(clave);

      if (ejercicio instanceof parser.Superserie serie) {
        List<parser.ElementoEjercicio> internos =
            filtrarEjercicios(serie.ejercicios, exclusiones, encontradas);
        if (!excluir && !internos.isEmpty())
          visibles.add(new parser.Superserie(nombre, serie.vueltas, internos, serie.descanso));
      } else if (!excluir) {
        visibles.add(ejercicio);
      }
    }
    return visibles;
  }

  parser.ModificadorRepeticion validarRepeticionVeces(
      String cantidad, boolean singular, int linea) {
      BigInteger vueltas = entero(cantidad);
      if (vueltas.signum() <= 0) {
          error(linea, "la cantidad de veces debe ser un entero positivo (se encontró "
                + cantidad + ")");
      } else {
          boolean correspondeSingular = vueltas.equals(BigInteger.ONE);
          if (singular != correspondeSingular)
              error(linea, "la cantidad " + cantidad + " debe concordar con '"
                    + (correspondeSingular ? "vez" : "veces") + "'");
      }
      return new parser.ModificadorRepeticion(vueltas, null);
  }

  parser.ModificadorRepeticion validarPorcentajeRepeticion(String porcentaje, int linea) {
      String cantidad = porcentaje.substring(0, porcentaje.length() - 1);
      BigInteger valor = entero(cantidad);
      if (valor.signum() <= 0) {
          error(linea, "el porcentaje de repetición debe ser positivo (se encontró "
                + porcentaje + ")");
      } else if (!valor.mod(BigInteger.valueOf(100)).equals(
                     BigInteger.ZERO)) {
          error(linea, "el porcentaje de repetición debe ser múltiplo de 100 "
                + "(se encontró " + porcentaje + ")");
      }
      return new parser.ModificadorRepeticion(null, porcentaje);
  }

  /* Valida la referencia una sola vez. El mismo origen ya validado alimenta la
     herencia de campos y la resolución de ejercicios. */
  parser.Rutina resolverOrigenHerencia(
      String nombreRutina, parser.CuerpoRutina cuerpo) {
    if (!cuerpo.esReferencia()) return null;
    String referencia = cuerpo.rutinaReferenciada;
    int linea = cuerpo.lineaReferencia;
    if (parser.claveRutina(nombreRutina).equals(parser.claveRutina(referencia))) {
      error(linea, "la rutina '" + nombreRutina + "' no puede referenciarse a sí misma");
      return null;
    }

    Optional<parser.Rutina> encontrada = parser.buscarRutina(referencia);
    if (encontrada.isEmpty()) {
      error(linea, "la rutina referenciada '" + referencia
          + "' no existe o todavía no fue declarada");
      return null;
    }

    parser.Rutina origen = encontrada.get();
    if (!origen.esValida()) {
      String motivo = origen.tieneErroresLexicos
          ? "tiene errores léxicos" : "es semánticamente inválida";
      error(linea, "la rutina referenciada '" + referencia
          + "' " + motivo + " y no puede reutilizarse");
      return null;
    }

    return origen;
  }

  /* Resuelve los ejercicios y conserva una capa por referencia. Cada capa
     contiene la secuencia visible luego de sus propias exclusiones; el cuerpo
     declarado y la ejecución referenciada permanecen intactos. */
  parser.EjecucionRutina resolverEjecucion(
      parser.CuerpoRutina cuerpo, parser.Rutina origen) {
    if (!cuerpo.esReferencia())
      return new parser.EjecucionRutina(cuerpo.ejerciciosPropios, cuerpo.repeticion, null);
    if (origen == null)
      return new parser.EjecucionRutina(
          Collections.emptyList(), cuerpo.repeticion, null);

    List<parser.ElementoEjercicio> visibles =
        aplicarExclusiones(origen.getEjercicios(), cuerpo);
    return new parser.EjecucionRutina(visibles, cuerpo.repeticion, origen.ejecucion);
  }

  List<parser.Campo> unir(List<parser.Campo> a, List<parser.Campo> b) {
    List<parser.Campo> resultado = new ArrayList<>(a);
    resultado.addAll(b);
    return resultado;
  }

  /* ===================== ESPECIFICACIONES DE EJERCICIO ===================== */

  void positivo(String valor, int linea, String descripcion) {
      if (entero(valor).signum() <= 0)
          error(linea, descripcion + " debe ser mayor que cero (se encontró " + valor + ")");
  }

  String validarSeries(String valor, int linea) {
    int separador = valor.indexOf('x');
    positivo(valor.substring(0, separador), linea, "la cantidad de series");
    return valor.substring(separador + 1);
  }

  void validarTiempoEjercicio(String valor, int linea) {
      String numero = valor.substring(0, valor.length() - 1);
      positivo(numero, linea, "el tiempo");
  }

  void validarCarga(String carga, int linea) {
    boolean esPorcentaje = carga.endsWith("%1RM");
    int longitudUnidad = esPorcentaje ? 4 : 2;
    BigDecimal cantidad = new BigDecimal(carga.substring(0, carga.length() - longitudUnidad));
    if (esPorcentaje) {
      if (cantidad.signum() <= 0 || cantidad.compareTo(BigDecimal.valueOf(100)) > 0)
        error(linea, "la carga porcentual '" + carga
            + "' debe estar entre 0 y 100 (excluyendo 0)");
    } else if (cantidad.signum() <= 0) {
      error(linea, "la carga '" + carga + "' debe ser positiva");
    }
  }

  void validarVelocidad(String velocidad, int linea) {
      String cantidad = velocidad.substring(0, velocidad.length() - 4);

      if (new BigDecimal(cantidad).signum() <= 0)
          error(linea, "la velocidad '" + velocidad + "' debe ser positiva");
  }

  void validarVueltas(BigInteger vueltas, int linea) {
      if (vueltas.compareTo(BigInteger.TWO) < 0)
          error(linea, "la superserie requiere al menos 2 vueltas");
  }

  void validarSuperserie(int ejercicios, int linea) {
      if (ejercicios < 2)
          error(linea, "la superserie requiere al menos 2 ejercicios");
  }
:};

/* DECLARACIÓN DE TERMINALES */
terminal NIVEL, OBJETIVOS, SEMANAS, PROFESOR, FECHA_KW;
terminal parser.TokenRutina RUTINA;
terminal DIA, CALENTAMIENTO, INTENSIDAD, DURACION, MUSCULOS,
         EQUIPAMIENTO, VARIANTES, EXTRA, OBS, EJERCICIOS;
terminal DOSPUNTOS, COMA, CORCH_A, CORCH_C, PAREN_A, PAREN_C, IGUAL;

terminal String PLAN, PALABRA, NOMBRE, CADENA, FECHA, FRACCION, ESTRELLAS, TIEMPO, ENTERO;

/* Ejercicios y reutilización de rutinas */
terminal SUPERSERIE, FIN, ARROBA;
terminal String DESCANSO, REPS, VUELTA;
terminal String SERIES_REPS, SERIES_MAX, SERIES_TIEMPO, CARGA, VELOCIDAD;
terminal IGUAL_A;
terminal String EXCEPTO, POR, VEZ, VECES, PORCENTAJE;

/* DECLARACIÓN DE NO TERMINALES */
non terminal List<parser.Rutina> plan, rutinas;
non terminal parser.Rutina rutina;
non terminal Integer inicio_rutina;
non terminal encabezado;
non terminal List<parser.Campo> campos_enc, campos_rut;
non terminal parser.Campo campo_enc, campo_rut;
non terminal String nombre, parte_nombre, nombre_superserie_opt;
non terminal List<String> lista, items;
non terminal Integer intensidad;
non terminal List<String[]> pares;
non terminal String[] par;
non terminal String valor_extra;
non terminal parser.CuerpoRutina cuerpo;
non terminal List<parser.ElementoEjercicio> lista_ej;
non terminal parser.ElementoEjercicio ejercicio;
non terminal parser.EspecificacionEjercicio spec;
non terminal String descanso_opt, carga_opt, velocidad_opt;
non terminal parser.ModificadorRepeticion repeticion_opt;
non terminal parser.ClausulaExclusion excepto_opt;

/* SÍMBOLO INICIAL */
start with plan;

/* =====================================================================
   GRAMÁTICA
   ===================================================================== */

plan ::= encabezado:e rutinas:r
         {: if (r.isEmpty()) error(eleft, "el plan no tiene ninguna rutina");
            RESULT = r; :}
       ;

/* ---------- Encabezado (los campos pueden venir en cualquier orden) ---------- */

encabezado ::= PLAN:p CADENA:nom campos_enc:c
             {: validarTexto(nom, pleft, "el plan no tiene nombre");
                validarEncabezado(c, pleft); :}
             | PLAN error
             ;

campos_enc ::= campos_enc:l campo_enc:c  {: l.add(c); RESULT = l; :}
             | /* vacío */                {: RESULT = new ArrayList<>(); :}
             ;

campo_enc ::= NIVEL:k PALABRA:n
              {: validarNivel(n, kleft); RESULT = new parser.Campo("Nivel", kleft, n); :}
            | OBJETIVOS:k lista:l
              {: RESULT = crearCampoLista("Objetivos", l, kleft); :}
            | SEMANAS:k ENTERO:s
              {: validarSemanas(s, kleft); RESULT = new parser.Campo("Semanas", kleft, s); :}
            | PROFESOR:k CADENA:p
              {: validarTexto(p, kleft, "el nombre del profesor está vacío");
                 RESULT = new parser.Campo("Profesor", kleft, p); :}
            | FECHA_KW:k FECHA:f
              {: validarFecha(f, kleft); RESULT = new parser.Campo("Fecha", kleft, f); :}
            ;

/* ---------- Rutinas ---------- */

rutinas ::= rutinas:l rutina:r
            {: if (r != null) l.add(r); RESULT = l; :}
          | /* vacío */
            {: RESULT = new ArrayList<>(); :}
          ;

/* Campos antes y después del cuerpo, en cualquier orden.
   Si hay un error adentro, se descarta hasta la próxima RUTINA. */
rutina ::= RUTINA:r inicio_rutina:i CADENA:nom campos_rut:a cuerpo:c campos_rut:b
           {: List<parser.Campo> campos = unir(a, b);
              boolean nombreNuevo = validarDeclaracionRutina(nom, campos, rleft);
              parser.Rutina origen = resolverOrigenHerencia(nom, c);
              List<parser.Campo> camposEfectivos = resolverCampos(campos, origen);
              if (!c.esReferencia() || origen != null)
                validarCamposObligatorios(nom, camposEfectivos, rleft);
              parser.EjecucionRutina ejecucion = resolverEjecucion(c, origen);
              int cantidadErrores = parser.getErroresSemanticos() - i;
              parser.Rutina nueva = new parser.Rutina(
                  nom, campos, camposEfectivos, c, ejecucion,
                  cantidadErrores == 0, cantidadErrores, r.tieneErroresLexicos());
              parser.registrarRutina(nueva, nombreNuevo);
              RESULT = nueva; :}
         | RUTINA error
           {: RESULT = null; :}
         ;

/* Marca cuántos errores semánticos había al comenzar la declaración. */
inicio_rutina ::= /* vacío */ {: RESULT = parser.getErroresSemanticos(); :}
               ;

campos_rut ::= campos_rut:l campo_rut:c  {: l.add(c); RESULT = l; :}
             | /* vacío */                {: RESULT = new ArrayList<>(); :}
             ;

campo_rut ::= DIA:k PALABRA:d
              {: validarDia(d, kleft); RESULT = new parser.Campo("Día", kleft, d); :}
            | CALENTAMIENTO:k CADENA:c
              {: validarTexto(c, kleft, "el calentamiento está vacío");
                 RESULT = new parser.Campo("Calentamiento", kleft, c); :}
            | INTENSIDAD:k intensidad:i
              {: RESULT = new parser.Campo("Intensidad", kleft, i); :}
            | DURACION:k TIEMPO:t
              {: RESULT = new parser.Campo("Duración", kleft, validarDuracion(t, kleft)); :}
            | MUSCULOS:k lista:l
              {: RESULT = crearCampoLista("Músculos", l, kleft); :}
            | EQUIPAMIENTO:k lista:l
              {: RESULT = crearCampoLista("Equipamiento", l, kleft); :}
            | VARIANTES:k lista:l
              {: RESULT = crearCampoLista("Variantes", l, kleft); :}
            | EXTRA:k pares:p
              {: validarExtra(p, kleft); RESULT = new parser.Campo("Extra", kleft, p); :}
            | OBS:k CADENA:o
              {: validarTexto(o, kleft, "la observación está vacía");
                 RESULT = new parser.Campo("Obs", kleft, o); :}
            ;

intensidad ::= FRACCION:f   {: RESULT = intensidadFraccion(f, fleft); :}
             | ESTRELLAS:e  {: RESULT = intensidadEstrellas(e, eleft); :}
             | nombre:t     {: RESULT = intensidadTexto(t, tleft); :}
             ;
/* Los nombres pueden incluir números, palabras compuestas y aclaraciones
   entre paréntesis. */
nombre ::= nombre:n parte_nombre:p {: RESULT = n + " " + p; :}
         | parte_nombre:p {: RESULT = p; :};

parte_nombre ::= PALABRA:p  {: RESULT = p; :}
               | NOMBRE:p   {: RESULT = p; :}
               | ENTERO:p   {: RESULT = p; :}
               | TIEMPO:p   {: RESULT = p; :}
               | PLAN:p     {: RESULT = p; :}
               | DESCANSO:p {: RESULT = p; :}
               | REPS:p     {: RESULT = p; :}
               | VUELTA:p   {: RESULT = p; :}
               | EXCEPTO:p  {: RESULT = p; :}
               | POR:p      {: RESULT = p; :}
               | VEZ:p      {: RESULT = p; :}
               | VECES:p    {: RESULT = p; :}
               | PAREN_A nombre:n PAREN_C {: RESULT = "(" + n + ")"; :}
               | PAREN_A PAREN_C          {: RESULT = "()"; :}
               ;

lista ::= CORCH_A items:l CORCH_C {: RESULT = l; :}
        | CORCH_A CORCH_C {: RESULT = new ArrayList<>(); :};

items ::= items:l COMA nombre:n {: l.add(n); RESULT = l; :}
        | nombre:n {: RESULT = new ArrayList<>(); RESULT.add(n); :};

pares ::= pares:l COMA par:p {: l.add(p); RESULT = l; :}
        | par:p {: RESULT = new ArrayList<>(); RESULT.add(p); :};

par ::= nombre:e IGUAL valor_extra:v {: RESULT = new String[]{e, v}; :};

valor_extra ::= nombre:n {: RESULT = n; :}
              | CADENA:c {: RESULT = c; :};

cuerpo ::= EJERCICIOS lista_ej:l
           {: RESULT = new parser.CuerpoRutina(
                l, null, new parser.ModificadorRepeticion(null, null), Collections.emptyList()); :}
         | IGUAL_A:k CADENA:r repeticion_opt:m excepto_opt:e
           {: RESULT = new parser.CuerpoRutina(
                Collections.emptyList(), r, kleft, m, e.nombres, e.presente, e.linea); :}
         ;

lista_ej ::= lista_ej:l ejercicio:e
             {: l.add(e); RESULT = l; :}
           | ejercicio:e
             {: RESULT = new ArrayList<>(); RESULT.add(e); :}
           ;

ejercicio ::= nombre:n DOSPUNTOS spec:s
              {: validarNombreReservado(n, "del ejercicio", nleft);
                 RESULT = new parser.Ejercicio(n, s); :}
            | nombre_superserie_opt:n SUPERSERIE:k ENTERO:v VUELTA lista_ej:l FIN SUPERSERIE descanso_opt:d
              {: BigInteger vueltas = entero(v);
                 if (n != null) validarNombreReservado(n, "de la superserie", nleft);
                 validarVueltas(vueltas, vleft);
                 validarSuperserie(l.size(), kleft);
                 RESULT = new parser.Superserie(n, vueltas, l, d); :}
            ;

nombre_superserie_opt ::= nombre:n {: RESULT = n; :}
                        | /* vacío */ {: RESULT = null; :}
                        ;

spec ::= SERIES_REPS:r carga_opt:c descanso_opt:d
         {: String repeticiones = validarSeries(r, rleft);
            positivo(repeticiones, rleft, "la cantidad de repeticiones");
            RESULT = new parser.EspecificacionEjercicio(
                "SERIES_REPETICIONES", r, c, d, null); :}
       | SERIES_MAX:r descanso_opt:d
         {: validarSeries(r, rleft);
            RESULT = new parser.EspecificacionEjercicio(
                "SERIES_MAXIMO", r, null, d, null); :}
       | SERIES_TIEMPO:t descanso_opt:d
         {: validarTiempoEjercicio(validarSeries(t, tleft), tleft);
            RESULT = new parser.EspecificacionEjercicio(
                "SERIES_TIEMPO", t, null, d, null); :}
       | ENTERO:r REPS carga_opt:c descanso_opt:d
         {: positivo(r, rleft, "la cantidad de repeticiones");
            RESULT = new parser.EspecificacionEjercicio(
                "REPETICIONES", r, c, d, null); :}
       | TIEMPO:t velocidad_opt:v
         {: validarTiempoEjercicio(t, tleft);
            RESULT = new parser.EspecificacionEjercicio(
                "TIEMPO", t, null, null, v); :}
       ;

carga_opt ::= ARROBA CARGA:c
              {: validarCarga(c, cleft); RESULT = c; :}
            | /* vacío */
              {: RESULT = null; :}
            ;

velocidad_opt ::= ARROBA VELOCIDAD:v
                  {: validarVelocidad(v, vleft); RESULT = v; :}
                | /* vacío */
                  {: RESULT = null; :}
                ;

descanso_opt ::= COMA DESCANSO TIEMPO:t
                 {: validarTiempoEjercicio(t, tleft); RESULT = t; :}
               | /* vacío */
                 {: RESULT = null; :}
               ;

repeticion_opt ::= POR ENTERO:n VEZ
                   {: RESULT = validarRepeticionVeces(n, true, nleft); :}
                 | POR ENTERO:n VECES
                   {: RESULT = validarRepeticionVeces(n, false, nleft); :}
                 | PORCENTAJE:p
                   {: RESULT = validarPorcentajeRepeticion(p, pleft); :}
                 | /* vacío */
                   {: RESULT = new parser.ModificadorRepeticion(null, null); :}
                 ;

excepto_opt ::= EXCEPTO:k lista:l
                 {: RESULT = new parser.ClausulaExclusion(l, true, kleft); :}
              | /* vacío */
                 {: RESULT = new parser.ClausulaExclusion(
                      Collections.emptyList(), false, -1); :}
              ;
