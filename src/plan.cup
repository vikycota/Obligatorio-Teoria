import java_cup.runtime.*;

parser code {:
  public void syntax_error(Symbol s) {
    System.err.println("Error sintáctico, línea " + s.left + ", cerca de: " + s.value);
  }
:};

terminal PLAN, SEMANAS;
terminal String CADENA;
terminal Integer ENTERO;

non terminal plan;

plan ::= PLAN CADENA:nombre SEMANAS ENTERO:n
       {: if (n < 1 || n > 52) System.err.println("Error semántico: Semanas fuera de rango (" + n + ")");
          else System.out.println("OK: " + nombre + ", " + n + " semanas"); :}
       ;